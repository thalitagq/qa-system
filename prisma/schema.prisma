generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum TestType {
  ANALYSIS
  NEW_FEATURE
  BUG_FIX
  IMPROVEMENT
  REGRESSION
}

enum TestStatus {
  DRAFT
  ANALYSIS
  READY
  EXECUTED
}

model Project {
  id          String     @id @default(uuid())
  name        String
  description String?
  active      Boolean    @default(true)
  testCases   TestCase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestCase {
  id          String     @id @default(uuid())
  title       String
  description String?
  type        TestType
  status      TestStatus

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  steps TestStep[]
  rules BusinessRule[] @relation("TestCaseRules")


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestStep {
  id             String @id @default(uuid())
  testCaseId     String
  order          Int
  action         String
  expectedResult String

  testCase TestCase @relation(fields: [testCaseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([testCaseId, order])
}

model BusinessRule {
  id              String     @id @default(uuid())
  code            String     @unique
  title           String
  normalizedTitle String     @unique
  description     String?
  active          Boolean    @default(true)
  testCases       TestCase[] @relation("TestCaseRules")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  QA
  VIEWER
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(QA)

  createdAt DateTime @default(now())
}
