{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testMatch": ["<rootDir>/test/**/*.e2e-spec.ts"],
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1",
    "^@prisma/(.*)$": [
      "<rootDir>/prisma/$1",
      "<rootDir>/node_modules/@prisma/$1"
    ],
    "^prisma/(.*)$": [
      "<rootDir>/prisma/$1",
      "<rootDir>/node_modules/prisma/$1"
    ],
    "^generated/(.*)$": "<rootDir>/generated/$1"
  },
  "setupFiles": ["<rootDir>/test/integration/setup-env.ts"],
  "testTimeout": 30000,
  "maxWorkers": 1
}
